# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only — used by the Tally webhook

# Tally
TALLY_SIGNING_SECRET=               # from the webhook you create in Tally (Integrations → Webhooks)
TALLY_FORM_IDS=vXDAE8               # comma-separated forms the webhook accepts
TALLY_API_KEY=                      # optional: enables "Sync from Tally" backfill

# AI (pay-per-use; pick one)
AI_PROVIDER=anthropic               # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=                           # optional override, e.g. claude-sonnet-5-5

# Google Calendar (read-only): Calendar settings → "Secret address in iCal format"
GOOGLE_CALENDAR_ICS_URL=
